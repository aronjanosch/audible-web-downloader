# Copy to .env (never commit .env). Docker Compose reads it automatically.

# REQUIRED. Signs session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First boot only. Leave ADMIN_PASSWORD empty to have one generated in
# config/initial-admin-credentials.json (0600), then delete that file after signing in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Network
BIND_ADDRESS=127.0.0.1
PORT=5505
TZ=UTC
# Number of reverse proxies in front of the app (0 = none). Needed for correct
# client IPs (login rate limit) and HTTPS detection behind Caddy/nginx/Traefik.
TRUSTED_PROXIES=0
# Set to 0 only for plain-HTTP on a trusted LAN. Keep 1 behind HTTPS.
SESSION_COOKIE_SECURE=1

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional Audiobookshelf integration (all three, or none)
ABS_URL=
ABS_API_TOKEN=
ABS_LIBRARY_ID=

# Pin a specific image tag instead of :latest
# AUDIBLE_IMAGE=ghcr.io/aronjanosch/audible-web-downloader:1.0.0
